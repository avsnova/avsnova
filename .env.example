##############################################################################
# Aurevashop — Environment Configuration Template
#
# HOW TO USE:
#   1. Copy this file to ".env"            ->  cp .env.example .env
#   2. Fill in REAL values for your server (never commit the real .env!)
#   3. Restart the app after any change.
#
# SECURITY: .env is git-ignored and must NEVER be committed. Keep secrets here
# only — no secret should ever be hard-coded in the source.
##############################################################################

# ─── Core ────────────────────────────────────────────────────────────────
# NODE_ENV must be "production" on the live server (enables strict security).
NODE_ENV=production
# Port the Node server listens on. On cPanel this is assigned automatically.
PORT=5000
# Public site URL (used for links in emails, CORS, SEO). No trailing slash.
PUBLIC_URL=https://yourdomain.com
# Comma-separated list of allowed browser origins for the API (CORS).
# Use your real domain(s). Leave blank to allow same-origin only.
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ─── Authentication ──────────────────────────────────────────────────────
# REQUIRED in production. Must be a long random string (>= 32 chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# ─── Database ────────────────────────────────────────────────────────────
# DB_TYPE = "sqlite" (default, file-based) or "mysql" (recommended for cPanel).
DB_TYPE=mysql
# --- MySQL (used only when DB_TYPE=mysql) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=your_db_name

# ─── SMTP (outgoing email: verification, receipts, notifications) ─────────
SMTP_HOST=smtp.yourmailserver.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_smtp_password_here
SMTP_FROM="Your Brand Support" <noreply@yourdomain.com>
SMTP_SENDER_NAME=Your Brand
SMTP_REPLY_TO=support@yourdomain.com

# ─── IMAP / POP3 (inbound mail parsing for email-verification services) ──
# Optional — only needed if you use the email-verification credential feature.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
POP3_HOST=
POP3_PORT=995
POP3_SECURE=true

# ─── Payment Gateways (add real production keys when you have them) ───────
# Paystack — https://dashboard.paystack.com/#/settings/developers
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key

# Monnify — https://app.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_CURRENCY=NGN
# MONNIFY_ENVIRONMENT: "sandbox" while testing, "production" (live) when ready.
MONNIFY_ENVIRONMENT=production

# Paga — https://www.paga.com
PAGA_PUBLIC_KEY=
PAGA_SECRET_KEY=
PAGA_HASH_KEY=
PAGA_BASE_URL=https://collect.paga.com/

# Flutterwave — https://dashboard.flutterwave.com  (add when integrating)
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

# PalmPay — (add when integrating)
PALMPAY_PUBLIC_KEY=
PALMPAY_SECRET_KEY=
PALMPAY_MERCHANT_ID=

# Nomba — (add when integrating)
NOMBA_CLIENT_ID=
NOMBA_PRIVATE_KEY=
NOMBA_ACCOUNT_ID=

# ─── SMS / Virtual Number Providers ──────────────────────────────────────
GRIZZLY_SMS_API_KEY=
FIVESIM_API_KEY=
SMSPOOL_API_KEY=

# ─── SMM Provider (JustAnotherPanel-compatible) ──────────────────────────
JAP_API_URL=https://justanotherpanel.com/api/v2
JAP_API_KEY=

# ─── AI Assistant (Google Gemini) ────────────────────────────────────────
GEMINI_API_KEY=

# ─── Telegram Bot (staff alerts) — optional ──────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_GROUP_CHAT_ID=
